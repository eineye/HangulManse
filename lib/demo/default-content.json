[{"id":"basic","title_ko":"기초한글","title_en":"Basic Hangul","description_ko":"인사, 자기소개, 숫자처럼 매일 쓰는 가장 기본적인 한국어를 배워요.","description_en":"Learn the most basic everyday Korean: greetings, self-introduction and numbers.","icon":"가","order":1,"published":true,"units":[{"id":"b1","title_ko":"인사하기","title_en":"Greetings","order":1,"level":"입문","situations":[{"id":"b1-s1","title_ko":"처음 만난 이웃에게 인사하기","title_en":"Greeting a new neighbor","description_ko":"새 아파트로 이사했어요. 엘리베이터에서 처음 만난 이웃에게 공손하게 인사해 봅시다.","description_en":"You just moved into a new apartment. Greet the neighbor you meet in the elevator politely.","goal_ko":"처음 만난 사람에게 존댓말로 인사하고 이름을 말할 수 있다.","goal_en":"Greet someone new in polite speech and say your name.","place_tag":"아파트","formality_tag":"존댓말","difficulty_tag":"초급","image":"🏢","roles":["새로 이사 온 주민","이웃 주민"],"terms":[{"id":"t-annyeong","hangul":"안녕하세요","romanization":"annyeonghaseyo","gloss_en":"Hello","category":"인사"},{"id":"t-cheoeum","hangul":"처음 뵙겠습니다","romanization":"cheoeum boepgetseumnida","gloss_en":"Nice to meet you (formal)","category":"인사"},{"id":"t-jeoneun","hangul":"저는","romanization":"jeoneun","gloss_en":"I am (humble)","category":"자기소개"},{"id":"t-ieyo","hangul":"이에요/예요","romanization":"ieyo/yeyo","gloss_en":"am / is (polite ending)","category":"문법"}],"sentences":[{"id":"b1-s1-1","text_ko":"안녕하세요. 처음 뵙겠습니다.","text_en":"Hello. Nice to meet you.","romanization":"annyeonghaseyo. cheoeum boepgetseumnida."},{"id":"b1-s1-2","text_ko":"저는 마리아예요.","text_en":"I am Maria.","romanization":"jeoneun mariayeyo."},{"id":"b1-s1-3","text_ko":"502호에 이사 왔어요.","text_en":"I moved into unit 502.","romanization":"obaegiho-e isa wasseoyo."}]},{"id":"b1-s2","title_ko":"헤어질 때 인사하기","title_en":"Saying goodbye","description_ko":"이웃과 이야기를 마치고 헤어질 때, 남는 사람과 떠나는 사람의 인사가 달라요.","description_en":"When parting, Korean uses different goodbyes for the person staying and the person leaving.","goal_ko":"상황에 맞게 '안녕히 가세요'와 '안녕히 계세요'를 구분해서 말할 수 있다.","goal_en":"Choose correctly between 'annyeonghi gaseyo' and 'annyeonghi gyeseyo'.","place_tag":"아파트","formality_tag":"존댓말","difficulty_tag":"초급","image":"👋","roles":["주민","이웃 주민"],"terms":[{"id":"t-gaseyo","hangul":"안녕히 가세요","romanization":"annyeonghi gaseyo","gloss_en":"Goodbye (to someone leaving)","category":"인사"},{"id":"t-gyeseyo","hangul":"안녕히 계세요","romanization":"annyeonghi gyeseyo","gloss_en":"Goodbye (to someone staying)","category":"인사"},{"id":"t-tto","hangul":"또 만나요","romanization":"tto mannayo","gloss_en":"See you again","category":"인사"},{"id":"t-gamsa","hangul":"감사합니다","romanization":"gamsahamnida","gloss_en":"Thank you","category":"인사"}],"sentences":[{"id":"b1-s2-1","text_ko":"만나서 반가웠어요.","text_en":"It was nice meeting you.","romanization":"mannaseo bangawosseoyo."},{"id":"b1-s2-2","text_ko":"안녕히 계세요. 또 만나요.","text_en":"Goodbye (you stay). See you again.","romanization":"annyeonghi gyeseyo. tto mannayo."},{"id":"b1-s2-3","text_ko":"감사합니다. 안녕히 가세요.","text_en":"Thank you. Goodbye (you go).","romanization":"gamsahamnida. annyeonghi gaseyo."}]}]},{"id":"b2","title_ko":"숫자와 시간","title_en":"Numbers and time","order":2,"level":"입문","situations":[{"id":"b2-s1","title_ko":"전화번호 말하기","title_en":"Telling your phone number","description_ko":"주민센터 직원이 연락처를 물어봐요. 전화번호를 또박또박 말해 봅시다.","description_en":"A community center staff member asks for your contact. Say your phone number clearly.","goal_ko":"한자어 숫자(일, 이, 삼…)로 전화번호를 말할 수 있다.","goal_en":"Say a phone number with Sino-Korean numbers (il, i, sam…).","place_tag":"주민센터","formality_tag":"존댓말","difficulty_tag":"초급","image":"📞","roles":["민원인","주민센터 직원"],"terms":[{"id":"t-gong","hangul":"공","romanization":"gong","gloss_en":"zero (in phone numbers)","category":"숫자"},{"id":"t-il-i-sam","hangul":"일, 이, 삼","romanization":"il, i, sam","gloss_en":"one, two, three","category":"숫자"},{"id":"t-jeonhwa","hangul":"전화번호","romanization":"jeonhwabeonho","gloss_en":"phone number","category":"생활"},{"id":"t-dasi","hangul":"다시 한번","romanization":"dasi hanbeon","gloss_en":"once more","category":"생활"}],"sentences":[{"id":"b2-s1-1","text_ko":"제 전화번호는 공일공이에요.","text_en":"My phone number starts with 010.","romanization":"je jeonhwabeonhoneun gongilgong-ieyo."},{"id":"b2-s1-2","text_ko":"천이백삼십사, 오천육백칠십팔이에요.","text_en":"It's 1234-5678.","romanization":"cheonibaeksamsipsa, ocheonyukbaekchilsippal-ieyo."},{"id":"b2-s1-3","text_ko":"다시 한번 말씀해 주세요.","text_en":"Could you say that once more, please?","romanization":"dasi hanbeon malsseumhae juseyo."}]}]}]},{"id":"daily","title_ko":"생활한글","title_en":"Everyday Korean","description_ko":"마트, 병원, 버스처럼 생활 속 여러 장소에서 필요한 한국어를 연습해요.","description_en":"Practice the Korean you need at the mart, the clinic, on the bus and more.","icon":"🛒","order":2,"published":true,"units":[{"id":"d1","title_ko":"장보기","title_en":"Grocery shopping","order":1,"level":"초급","situations":[{"id":"d1-s1","title_ko":"마트에서 물건 찾기","title_en":"Finding items at the mart","description_ko":"동네 마트에서 우유를 찾고 있어요. 직원에게 위치를 물어보고 가격을 확인해 봅시다.","description_en":"You're looking for milk at a local mart. Ask a staff member where it is and check the price.","goal_ko":"물건의 위치와 가격을 존댓말로 물어볼 수 있다.","goal_en":"Politely ask where an item is and how much it costs.","place_tag":"마트","formality_tag":"존댓말","difficulty_tag":"초급","image":"🛒","roles":["손님","마트 직원"],"terms":[{"id":"t-eodi","hangul":"어디에 있어요?","romanization":"eodie isseoyo?","gloss_en":"Where is it?","category":"질문"},{"id":"t-eolma","hangul":"얼마예요?","romanization":"eolmayeyo?","gloss_en":"How much is it?","category":"질문"},{"id":"t-uyu","hangul":"우유","romanization":"uyu","gloss_en":"milk","category":"물건"},{"id":"t-bongtu","hangul":"봉투","romanization":"bongtu","gloss_en":"(shopping) bag","category":"물건"}],"sentences":[{"id":"d1-s1-1","text_ko":"저기요, 우유는 어디에 있어요?","text_en":"Excuse me, where is the milk?","romanization":"jeogiyo, uyuneun eodie isseoyo?"},{"id":"d1-s1-2","text_ko":"이거 얼마예요?","text_en":"How much is this?","romanization":"igeo eolmayeyo?"},{"id":"d1-s1-3","text_ko":"봉투 하나 주세요.","text_en":"One bag, please.","romanization":"bongtu hana juseyo."}]}]},{"id":"d2","title_ko":"병원과 약국","title_en":"Clinic and pharmacy","order":2,"level":"초급","situations":[{"id":"d2-s1","title_ko":"병원 접수하기","title_en":"Checking in at a clinic","description_ko":"아이가 열이 나서 소아과에 왔어요. 접수 창구에서 증상을 말해 봅시다.","description_en":"Your child has a fever, so you came to a pediatric clinic. Explain the symptoms at the reception desk.","goal_ko":"접수하고 아픈 곳과 증상을 간단히 말할 수 있다.","goal_en":"Check in and briefly describe where it hurts and the symptoms.","place_tag":"병원","formality_tag":"존댓말","difficulty_tag":"중급","image":"🏥","roles":["보호자","접수 간호사"],"terms":[{"id":"t-jeopsu","hangul":"접수","romanization":"jeopsu","gloss_en":"registration / check-in","category":"병원"},{"id":"t-yeol","hangul":"열이 나요","romanization":"yeori nayo","gloss_en":"has a fever","category":"증상"},{"id":"t-apayo","hangul":"아파요","romanization":"apayo","gloss_en":"it hurts","category":"증상"},{"id":"t-boheom","hangul":"건강보험증","romanization":"geongangboheomjeung","gloss_en":"health insurance card","category":"병원"}],"sentences":[{"id":"d2-s1-1","text_ko":"진료 접수하려고 왔어요.","text_en":"I'm here to register for an appointment.","romanization":"jillyo jeopsuharyeogo wasseoyo."},{"id":"d2-s1-2","text_ko":"아이가 어제부터 열이 나요.","text_en":"My child has had a fever since yesterday.","romanization":"aiga eojebuteo yeori nayo."},{"id":"d2-s1-3","text_ko":"목도 아프고 기침도 해요.","text_en":"Their throat hurts and they're coughing too.","romanization":"mokdo apeugo gichimdo haeyo."}]}]},{"id":"d3","title_ko":"대중교통","title_en":"Public transport","order":3,"level":"초급","situations":[{"id":"d3-s1","title_ko":"버스 타기","title_en":"Taking the bus","description_ko":"시장에 가려고 버스를 탔어요. 기사님께 이 버스가 시장에 가는지 물어봅시다.","description_en":"You got on a bus to go to the market. Ask the driver whether this bus goes there.","goal_ko":"목적지를 말하고 내릴 곳을 물어볼 수 있다.","goal_en":"State your destination and ask where to get off.","place_tag":"버스","formality_tag":"존댓말","difficulty_tag":"초급","image":"🚌","roles":["승객","버스 기사"],"terms":[{"id":"t-gayo","hangul":"가요?","romanization":"gayo?","gloss_en":"Does it go?","category":"질문"},{"id":"t-naeryeoyo","hangul":"내려요","romanization":"naeryeoyo","gloss_en":"get off","category":"교통"},{"id":"t-jeongnyujang","hangul":"정류장","romanization":"jeongnyujang","gloss_en":"bus stop","category":"교통"},{"id":"t-gyotongkadeu","hangul":"교통카드","romanization":"gyotongkadeu","gloss_en":"transit card","category":"교통"}],"sentences":[{"id":"d3-s1-1","text_ko":"기사님, 이 버스 시장에 가요?","text_en":"Driver, does this bus go to the market?","romanization":"gisanim, i beoseu sijange gayo?"},{"id":"d3-s1-2","text_ko":"어디에서 내려요?","text_en":"Where do I get off?","romanization":"eodieseo naeryeoyo?"},{"id":"d3-s1-3","text_ko":"다음 정류장에서 내릴게요.","text_en":"I'll get off at the next stop.","romanization":"daeum jeongnyujang-eseo naeril-geyo."}]}]}]},{"id":"etiquette","title_ko":"예절한글","title_en":"Korean Etiquette","description_ko":"학교, 이웃집, 공공장소에서 지켜야 할 예절과 높임말을 배워요.","description_en":"Learn the manners and honorifics expected at school, at a neighbor's home and in public places.","icon":"🙇","order":3,"published":true,"units":[{"id":"e1","title_ko":"학교에서","title_en":"At school","order":1,"level":"초급","situations":[{"id":"e1-s1","title_ko":"담임 선생님과 상담하기","title_en":"Meeting the homeroom teacher","description_ko":"학부모 상담 주간이에요. 담임 선생님께 높임말로 아이의 학교생활을 여쭤봅시다.","description_en":"It's parent-teacher conference week. Ask the homeroom teacher about your child's school life using honorifics.","goal_ko":"'-시-' 높임과 '여쭤보다', '말씀' 같은 높임 어휘를 쓸 수 있다.","goal_en":"Use the honorific '-si-' and honorific words like 'yeojjwoboda' and 'malsseum'.","place_tag":"학교","formality_tag":"존댓말","difficulty_tag":"중급","image":"🏫","roles":["학부모","담임 선생님"],"terms":[{"id":"t-seonsaengnim","hangul":"선생님","romanization":"seonsaengnim","gloss_en":"teacher (honorific)","category":"호칭"},{"id":"t-yeojjwo","hangul":"여쭤보다","romanization":"yeojjwoboda","gloss_en":"to ask (humble, to a superior)","category":"높임말"},{"id":"t-malsseum","hangul":"말씀","romanization":"malsseum","gloss_en":"words / speech (honorific)","category":"높임말"},{"id":"t-sugo","hangul":"수고하셨습니다","romanization":"sugohasyeotseumnida","gloss_en":"Thank you for your hard work","category":"인사"}],"sentences":[{"id":"e1-s1-1","text_ko":"선생님, 안녕하세요. 지민이 엄마예요.","text_en":"Hello, teacher. I'm Jimin's mother.","romanization":"seonsaengnim, annyeonghaseyo. jiminiomma-yeyo."},{"id":"e1-s1-2","text_ko":"아이 학교생활에 대해 여쭤보고 싶어요.","text_en":"I'd like to ask about my child's school life.","romanization":"ai hakgyosaenghware daehae yeojjwobogo sipeoyo."},{"id":"e1-s1-3","text_ko":"말씀해 주셔서 감사합니다.","text_en":"Thank you for telling me.","romanization":"malsseumhae jusyeoseo gamsahamnida."}]}]},{"id":"e2","title_ko":"공공장소 규칙","title_en":"Rules in public places","order":2,"level":"초급","situations":[{"id":"e2-s1","title_ko":"분리수거 규칙 묻기","title_en":"Asking about recycling rules","description_ko":"한국 아파트는 요일과 종류별로 쓰레기를 나눠 버려요. 경비원께 분리수거 방법을 여쭤봅시다.","description_en":"Korean apartments separate waste by type and day. Ask the security guard how recycling works.","goal_ko":"규칙을 물어보고, 몰랐던 것에 대해 공손하게 사과할 수 있다.","goal_en":"Ask about rules and politely apologize for not knowing.","place_tag":"아파트 분리수거장","formality_tag":"존댓말","difficulty_tag":"초급","image":"♻️","roles":["주민","경비원"],"terms":[{"id":"t-bunrisugeo","hangul":"분리수거","romanization":"bullisugeo","gloss_en":"recycling / waste separation","category":"생활 규칙"},{"id":"t-jongnyangje","hangul":"종량제 봉투","romanization":"jongnyangje bongtu","gloss_en":"official pay-as-you-throw bag","category":"생활 규칙"},{"id":"t-joesong","hangul":"죄송합니다","romanization":"joesonghamnida","gloss_en":"I'm sorry (formal)","category":"사과"},{"id":"t-mollasseoyo","hangul":"몰랐어요","romanization":"mollasseoyo","gloss_en":"I didn't know","category":"사과"}],"sentences":[{"id":"e2-s1-1","text_ko":"분리수거는 무슨 요일에 해요?","text_en":"On which day do we do recycling?","romanization":"bullisugeoneun museun yoire haeyo?"},{"id":"e2-s1-2","text_ko":"죄송합니다. 규칙을 몰랐어요.","text_en":"I'm sorry. I didn't know the rule.","romanization":"joesonghamnida. gyuchigeul mollasseoyo."},{"id":"e2-s1-3","text_ko":"종량제 봉투는 어디에서 사요?","text_en":"Where do I buy the official trash bags?","romanization":"jongnyangje bongtuneun eodieseo sayo?"}]},{"id":"e2-s2","title_ko":"지하철 예절","title_en":"Subway manners","description_ko":"지하철에는 노약자석과 임산부 배려석이 있어요. 자리를 양보하는 말을 연습해 봅시다.","description_en":"The subway has seats for the elderly and pregnant women. Practice offering your seat.","goal_ko":"어른께 자리를 양보하고, 지하철에서 지켜야 할 예절을 말할 수 있다.","goal_en":"Offer your seat to an elder and talk about subway etiquette.","place_tag":"지하철","formality_tag":"존댓말","difficulty_tag":"초급","image":"🚇","roles":["승객","할머니 승객"],"terms":[{"id":"t-noyakja","hangul":"노약자석","romanization":"noyakjaseok","gloss_en":"priority seat (elderly/disabled)","category":"공공장소"},{"id":"t-anjeuseyo","hangul":"여기 앉으세요","romanization":"yeogi anjeuseyo","gloss_en":"Please sit here","category":"높임말"},{"id":"t-jogyonghi","hangul":"조용히","romanization":"jogyonghi","gloss_en":"quietly","category":"공공장소"},{"id":"t-sillye","hangul":"실례합니다","romanization":"sillyehamnida","gloss_en":"Excuse me","category":"인사"}],"sentences":[{"id":"e2-s2-1","text_ko":"할머니, 여기 앉으세요.","text_en":"Ma'am, please sit here.","romanization":"halmeoni, yeogi anjeuseyo."},{"id":"e2-s2-2","text_ko":"실례합니다. 좀 지나갈게요.","text_en":"Excuse me, I'm going to pass by.","romanization":"sillyehamnida. jom jinagalgeyo."},{"id":"e2-s2-3","text_ko":"지하철에서는 조용히 통화해요.","text_en":"On the subway, we talk quietly on the phone.","romanization":"jihacheoreseoneun jogyonghi tonghwahaeyo."}]}]}]}]
